# FirstLight configuration — copy to `.env` (or export in your shell).
#
# Every value has a safe dev default; nothing here is required to run the
# Build It path locally. Production must inject FIRSTLIGHT_SECRET from a real
# secret manager (AWS Secrets Manager / SSM Parameter Store) — never commit it.

# --- Core ---
FIRSTLIGHT_HOST=127.0.0.1
FIRSTLIGHT_PORT=8000
# HMAC signing key for capability tokens. Dev default only — MUST be injected in prod.
FIRSTLIGHT_SECRET=dev-only-secret-change-me
# Token lifetime in seconds (default 24h).
FIRSTLIGHT_TOKEN_TTL=86400
FIRSTLIGHT_LOG=INFO

# --- Storage ---
FIRSTLIGHT_DB=./data/firstlight.db
FIRSTLIGHT_DATA=./data
FIRSTLIGHT_WEB=./web
# Seed the SQLite DB from the frozen morning on boot if it is empty.
FIRSTLIGHT_AUTO_SEED=true

# --- Outbound alert channels (Build It) ---
# One of: console | silent | smtp | webhook | sns | telegram
FIRSTLIGHT_NOTIFY=console
FIRSTLIGHT_SMTP_HOST=
FIRSTLIGHT_SMTP_PORT=587
FIRSTLIGHT_SMTP_USER=
FIRSTLIGHT_SMTP_PASSWORD=
FIRSTLIGHT_WEBHOOK_URL=
FIRSTLIGHT_SNS_TOPIC_ARN=
FIRSTLIGHT_TELEGRAM_TOKEN=
FIRSTLIGHT_TELEGRAM_CHAT_ID=
